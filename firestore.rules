rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function validProfile(d) {
      return str(d.firstName, 100) && str(d.lastName, 100)
        && str(d.country, 100) && str(d.phoneNumber, 30);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','title','content','timestamp'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.title, 200)
        && str(request.resource.data.content, 5000)
        && request.resource.data.timestamp == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','content'])
        && str(request.resource.data.title, 200)
        && str(request.resource.data.content, 5000);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      // consider moving email/phoneNumber to a private subcollection
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys()
             .hasOnly(['firstName','lastName','country','phoneNumber','email','createdAt'])
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName','lastName','country','phoneNumber'])
        && validProfile(request.resource.data);

      // users this user doesn't want messages from
      match /blocked/{blockedUid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && blockedUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }
    }

    // written in the same batch as every chat message, so messages can be throttled
    match /rateLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastMessageAt'])
        && request.resource.data.lastMessageAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastMessageAt'])
        && request.resource.data.lastMessageAt == request.time
        && resource.data.lastMessageAt + duration.value(2, 's') <= request.time;
    }

    match /chats/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in [resource.data.from, resource.data.to];
      // getAfter on rateLimits only passes if it was updated in this same batch
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['chatId','content','from','to','timestamp'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.to)/blocked/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastMessageAt == request.time
        && request.resource.data.chatId == (request.resource.data.from < request.resource.data.to
             ? request.resource.data.from + request.resource.data.to
             : request.resource.data.to + request.resource.data.from)
        && str(request.resource.data.content, 2000)
        && request.resource.data.timestamp == request.time;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
